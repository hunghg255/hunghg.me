{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/styles/globals.css",
    "functions": ["clsx", "cn", "cva"]
  },
  "ignorePatterns": [
    ".agents",
    ".claude",
    ".next",
    ".history",
    ".husky",
    "node_modules",
    "public",
    "src/__registry__/index.tsx",
    "src/__registry__/registry.autogenerated.json"
  ]
}
